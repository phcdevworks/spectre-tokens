{
  "name": "@phcdevworks/spectre-tokens",
  "version": "1.1.0",
  "description": "Spectre design tokens with JS, TS, Tailwind, and CSS variable outputs.",
  "keywords": [
    "phcdevworks",
    "spectre",
    "spectre-tokens",
    "design-tokens",
    "tokens",
    "css-variables",
    "css-custom-properties",
    "tailwindcss",
    "tailwind-theme",
    "theming",
    "ui-design",
    "typescript",
    "javascript"
  ],
  "author": "PHCDevworks",
  "license": "MIT",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/phcdevworks"
    },
    {
      "type": "buymeacoffee",
      "url": "https://buymeacoffee.com/phcdevworks"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/phcdevworks/spectre-tokens.git"
  },
  "bugs": {
    "url": "https://github.com/phcdevworks/spectre-tokens/issues"
  },
  "homepage": "https://github.com/phcdevworks/spectre-tokens#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./index.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "tokens"
  ],
  "sideEffects": false,
  "scripts": {
    "generate": "tsx scripts/generate-types.ts",
    "prebuild": "npm run generate",
    "build": "npm run build:ts && npm run build:css && npm run check:tokens",
    "build:ts": "tsup --config tsup.config.ts",
    "build:css": "tsx scripts/build-css.ts",
    "check:tokens": "tsx scripts/assert-core-tokens.ts",
    "check:contrast": "tsx scripts/check-contrast.ts",
    "check:regression": "tsx scripts/check-tokens-regression.ts",
    "check:ai": "tsx skills/ai-implementation/scripts/verify-ai-readiness.ts",
    "check": "npm run check:tokens && npm run check:contrast && npm run check:regression && npm run check:ai",
    "check:all": "npm run check",
    "test": "npm run check"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/chroma-js": "^3.1.2",
    "chroma-js": "^3.2.0",
    "colord": "^2.9.3",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "tsx": "^4.16.2",
    "typescript": "^5.9.3"
  }
}
