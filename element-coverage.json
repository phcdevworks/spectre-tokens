{
  "description": "Maps every standard HTML element and styleable pseudo-element to the token roles that style it. Validated by `npm run check:elements` against the canonical list in scripts/element-coverage.ts; an element with no visual styling of its own is marked `\"styling\": \"none\"` with a reason.",
  "elements": {
    "a": { "tokens": ["link.default", "link.hover", "link.active", "link.visited", "link.underline", "link.underlineHover", "textDecoration.thickness.thin", "textDecoration.offset.md", "accessibility.focusRing"] },
    "abbr": { "tokens": ["text.onPage.muted", "textDecoration.thickness.thin", "textDecoration.offset.sm"], "note": "dotted underline in the muted text colour" },
    "address": { "tokens": ["typography.body", "text.onPage.default"] },
    "area": { "styling": "none", "note": "image-map hotspot; renders no box" },
    "article": { "tokens": ["layout.stack.gap", "layout.prose.flow"] },
    "aside": { "tokens": ["surface.card", "text.onSurface.default", "layout.stack.gap"] },
    "audio": { "tokens": ["radii.md", "buttons.primary.bg"], "note": "native controls take the primary action colour through accent-color" },
    "b": { "tokens": ["fontWeight.bold"] },
    "base": { "styling": "none", "note": "document metadata" },
    "bdi": { "styling": "none", "note": "bidirectional isolation only" },
    "bdo": { "styling": "none", "note": "bidirectional override only" },
    "blockquote": { "tokens": ["component.quote", "component.prose.blockquote", "layout.prose.flow.blockquote"] },
    "body": { "tokens": ["surface.page", "text.onPage.default", "typography.body", "typography.families.sans"] },
    "br": { "styling": "none", "note": "line break; renders no box" },
    "button": { "tokens": ["buttons.primary", "control.md", "radii.md", "accessibility.focusRing", "accessibility.minTouchTarget"] },
    "canvas": { "tokens": ["component.chart", "aspectRatios"] },
    "caption": { "tokens": ["component.table.caption.text", "font.sm"] },
    "cite": { "tokens": ["component.quote.attributionName", "text.onPage.muted"] },
    "code": { "tokens": ["component.prose.code", "typography.families.mono", "radii.sm"] },
    "col": { "styling": "none", "note": "column styling comes from the table roles" },
    "colgroup": { "styling": "none", "note": "column styling comes from the table roles" },
    "data": { "styling": "none", "note": "machine-readable value; inherits text" },
    "datalist": { "styling": "none", "note": "suggestion list drawn by the browser" },
    "dd": { "tokens": ["component.prose.dd.text", "layout.prose.flow.listItem"] },
    "del": { "tokens": ["component.prose.del.bg", "component.prose.del.text"] },
    "details": { "tokens": ["component.accordion"] },
    "dfn": { "tokens": ["text.onPage.default", "fontWeight.semibold"] },
    "dialog": { "tokens": ["component.modal", "surface.overlay", "elevation.modal"] },
    "div": { "styling": "none", "note": "generic container" },
    "dl": { "tokens": ["layout.prose.flow.list"] },
    "dt": { "tokens": ["component.prose.dt.text", "fontWeight.semibold"] },
    "em": { "styling": "none", "note": "italic from the browser default" },
    "embed": { "tokens": ["aspectRatios.video", "radii.md"] },
    "fieldset": { "tokens": ["component.fieldset.border", "radii.md"] },
    "figcaption": { "tokens": ["component.prose.figcaption.text", "font.sm", "leading.snug"] },
    "figure": { "tokens": ["layout.prose.flow.figure"] },
    "footer": { "tokens": ["component.footer"] },
    "form": { "tokens": ["layout.stack.gap"] },
    "h1": { "tokens": ["typography.heading.h1", "text.onPage.default", "layout.prose.flow.heading", "layout.prose.flow.headingAfter"] },
    "h2": { "tokens": ["typography.heading.h2", "text.onPage.default", "layout.prose.flow.heading", "layout.prose.flow.headingAfter"] },
    "h3": { "tokens": ["typography.heading.h3", "text.onPage.default", "layout.prose.flow.heading", "layout.prose.flow.headingAfter"] },
    "h4": { "tokens": ["typography.heading.h4", "text.onPage.default", "layout.prose.flow.heading", "layout.prose.flow.headingAfter"] },
    "h5": { "tokens": ["typography.heading.h5", "text.onPage.default", "layout.prose.flow.heading", "layout.prose.flow.headingAfter"] },
    "h6": { "tokens": ["typography.heading.h6", "text.onPage.default", "layout.prose.flow.heading", "layout.prose.flow.headingAfter"] },
    "head": { "styling": "none", "note": "document metadata" },
    "header": { "tokens": ["component.nav", "layout.container"] },
    "hgroup": { "tokens": ["typography.heading", "text.onPage.muted"], "note": "subheading lines take the muted text colour" },
    "hr": { "tokens": ["component.prose.hr", "border.width", "layout.prose.flow.hr"] },
    "html": { "tokens": ["surface.page", "component.scrollbar", "component.caret"] },
    "i": { "styling": "none", "note": "italic from the browser default" },
    "iframe": { "tokens": ["aspectRatios.video", "radii.md", "border.width"] },
    "img": { "tokens": ["radii.md", "aspectRatios", "component.skeleton"] },
    "input": { "tokens": ["forms.default", "forms.focus", "forms.invalid", "forms.disabled", "control.md", "component.caret", "component.checkbox", "component.radio", "component.range", "component.fileInput", "component.datepicker"] },
    "ins": { "tokens": ["component.prose.ins.bg", "component.prose.ins.text"] },
    "kbd": { "tokens": ["component.prose.kbd", "typography.families.mono", "radii.sm"] },
    "label": { "tokens": ["component.label"] },
    "legend": { "tokens": ["component.fieldset.legendText", "fontWeight.semibold"] },
    "li": { "tokens": ["layout.prose.flow.listItem", "component.prose.marker"] },
    "link": { "styling": "none", "note": "document metadata" },
    "main": { "tokens": ["layout.container", "layout.section.padding"] },
    "map": { "styling": "none", "note": "image-map container; renders no box" },
    "mark": { "tokens": ["component.prose.mark"] },
    "math": { "tokens": ["typography.families.serif", "text.onPage.default"] },
    "menu": { "tokens": ["layout.prose.flow.list", "component.prose.marker"] },
    "meta": { "styling": "none", "note": "document metadata" },
    "meter": { "tokens": ["component.meter", "radii.pill"] },
    "nav": { "tokens": ["component.nav"] },
    "noscript": { "styling": "none", "note": "fallback content; inherits its context" },
    "object": { "tokens": ["aspectRatios.video", "radii.md"] },
    "ol": { "tokens": ["layout.prose.flow.list", "component.prose.marker"] },
    "optgroup": { "tokens": ["component.select.optgroup.labelText", "fontWeight.semibold"] },
    "option": { "tokens": ["component.select.option"] },
    "output": { "tokens": ["text.onPage.default", "fontWeight.medium"] },
    "p": { "tokens": ["typography.body", "text.onPage.default", "layout.prose.flow.paragraph", "layout.container.maxWidthProse"] },
    "picture": { "tokens": ["radii.md", "aspectRatios"] },
    "pre": { "tokens": ["component.prose.codeBlock", "component.code.syntax", "typography.families.mono", "radii.md"] },
    "progress": { "tokens": ["component.progress", "radii.pill"] },
    "q": { "tokens": ["component.quote.mark"] },
    "rp": { "styling": "none", "note": "ruby fallback parentheses; hidden where ruby is supported" },
    "rt": { "tokens": ["font.xs", "text.onPage.muted"] },
    "ruby": { "styling": "none", "note": "ruby container; inherits text" },
    "s": { "tokens": ["component.prose.del.text"], "note": "strike-through without the deletion background" },
    "samp": { "tokens": ["component.prose.code", "typography.families.mono"] },
    "script": { "styling": "none", "note": "not rendered" },
    "search": { "tokens": ["layout.stack.gap"] },
    "section": { "tokens": ["layout.section.padding", "layout.section.gap"] },
    "select": { "tokens": ["component.select", "control.md", "radii.md"] },
    "selectedcontent": { "tokens": ["component.select.text"] },
    "slot": { "styling": "none", "note": "shadow DOM insertion point; renders no box" },
    "small": { "tokens": ["font.sm", "text.onPage.muted"] },
    "source": { "styling": "none", "note": "media source; not rendered" },
    "span": { "styling": "none", "note": "generic inline container" },
    "strong": { "tokens": ["fontWeight.bold"] },
    "style": { "styling": "none", "note": "not rendered" },
    "sub": { "tokens": ["font.xs"] },
    "summary": { "tokens": ["component.accordion.header", "component.accordion.icon", "accessibility.focusRing"] },
    "sup": { "tokens": ["font.xs"] },
    "svg": { "tokens": ["icons", "component.chart"] },
    "table": { "tokens": ["component.table.text", "component.table.divider", "component.table.stripeBg", "component.table.hoverBg"] },
    "tbody": { "tokens": ["component.table.stripeBg", "component.table.hoverBg", "component.table.selectedBg"] },
    "td": { "tokens": ["component.table.text", "component.table.divider", "component.table.row"] },
    "template": { "styling": "none", "note": "not rendered" },
    "textarea": { "tokens": ["component.textarea", "forms.focus", "component.caret", "radii.md"] },
    "tfoot": { "tokens": ["component.table.footer.bg", "component.table.footer.text"] },
    "th": { "tokens": ["component.table.header.bg", "component.table.header.text", "fontWeight.semibold"] },
    "thead": { "tokens": ["component.table.header.bg"] },
    "time": { "styling": "none", "note": "machine-readable date; inherits text" },
    "title": { "styling": "none", "note": "document metadata" },
    "tr": { "tokens": ["component.table.hoverBg", "component.table.selectedBg", "component.table.row"] },
    "track": { "styling": "none", "note": "caption track; styled through ::cue" },
    "u": { "tokens": ["textDecoration.thickness.thin", "textDecoration.offset.sm"], "note": "wavy or solid underline in the current text colour" },
    "ul": { "tokens": ["layout.prose.flow.list", "component.prose.marker"] },
    "var": { "tokens": ["component.prose.code.text", "typography.families.mono"], "note": "italic from the browser default" },
    "video": { "tokens": ["aspectRatios.video", "radii.md", "component.skeleton"] },
    "wbr": { "styling": "none", "note": "line-break opportunity; renders no box" }
  },
  "pseudoElements": {
    "::after": { "styling": "none", "note": "generated content takes the roles of the element it decorates" },
    "::backdrop": { "tokens": ["surface.overlay"] },
    "::before": { "styling": "none", "note": "generated content takes the roles of the element it decorates" },
    "::cue": { "tokens": ["surface.inverse", "text.onInverse.default", "font.md"] },
    "::details-content": { "tokens": ["component.accordion"] },
    "::file-selector-button": { "tokens": ["component.fileInput.actionBg", "component.fileInput.actionText"] },
    "::first-letter": { "tokens": ["typography.display", "text.onPage.accent"], "note": "drop cap" },
    "::first-line": { "styling": "none", "note": "inherits the paragraph roles" },
    "::marker": { "tokens": ["component.prose.marker", "component.prose.markerAccent"] },
    "::placeholder": { "tokens": ["forms.default.placeholder"] },
    "::selection": { "tokens": ["component.selection"] },
    "::spelling-error": { "tokens": ["component.proofing.spelling", "textDecoration.thickness.thin"], "note": "wavy underline" },
    "::grammar-error": { "tokens": ["component.proofing.grammar", "textDecoration.thickness.thin"], "note": "wavy underline" },
    "::target-text": { "tokens": ["component.prose.mark"] }
  }
}
