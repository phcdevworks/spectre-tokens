{
  "surface": {
    "page": {
      "value": "{colors.neutral.50}",
      "description": "primary app background",
      "metadata": {
        "pair": "text.onPage.default"
      }
    },
    "card": {
      "value": "{colors.white}",
      "description": "containers and tiles",
      "metadata": {
        "pair": "text.onSurface.default"
      }
    },
    "input": {
      "value": "{colors.white}",
      "description": "form inputs, textareas",
      "metadata": {
        "pair": "text.onSurface.default"
      }
    },
    "overlay": {
      "value": "{colors.black} / 0.6",
      "description": "modals, dropdowns, flyouts"
    },
    "hover": {
      "value": "{colors.neutral.100}",
      "description": "background for hovered clickable rows, items, and menu entries"
    },
    "selected": {
      "value": "{colors.info.50}",
      "description": "background for selected list items, rows, and menu entries"
    },
    "active": {
      "value": "{colors.neutral.200}",
      "description": "background for pressed/active clickable rows, items, and menu entries"
    },
    "divider": {
      "value": "{colors.neutral.200}",
      "description": "hairline color for <hr>, table borders, and section separators"
    },
    "inverse": {
      "value": "{colors.neutral.900}",
      "description": "fixed dark background for content islands not owned by the page's own light/dark mode \u2014 photo-backed cards, brand-dark card bodies, utility bars",
      "metadata": {
        "pair": "text.onInverse.default"
      }
    }
  },
  "link": {
    "default": {
      "value": "{colors.brand.600}",
      "description": "default inline link color",
      "metadata": {
        "pair": "surface.page"
      }
    },
    "hover": {
      "value": "{colors.brand.700}",
      "description": "link color on hover"
    },
    "active": {
      "value": "{colors.brand.800}",
      "description": "link color while pressed"
    },
    "visited": {
      "value": "{colors.accent.700}",
      "description": "link color after the destination has been visited"
    },
    "onInverse": {
      "value": "{colors.neutral.300}",
      "description": "default inline link color on surface.inverse, independent of page mode",
      "metadata": {
        "pair": "surface.inverse"
      }
    },
    "onInverseHover": {
      "value": "{colors.brand.300}",
      "description": "link color on hover, on surface.inverse"
    }
  },
  "text": {
    "onPage": {
      "default": {
        "value": "{colors.neutral.900}",
        "description": "base text on page background",
        "metadata": {
          "pair": "surface.page"
        }
      },
      "muted": {
        "value": "{colors.neutral.600}",
        "description": "muted text for de-emphasized content",
        "metadata": {
          "pair": "surface.page"
        }
      },
      "subtle": {
        "value": "{colors.neutral.500}",
        "description": "subtle text for secondary labels",
        "metadata": {
          "pair": "surface.page"
        }
      },
      "meta": {
        "value": "{colors.neutral.500}",
        "description": "meta text for smallest labels and timestamps",
        "metadata": {
          "pair": "surface.page"
        }
      },
      "brand": "{colors.brand.600}"
    },
    "onSurface": {
      "default": {
        "value": "{colors.neutral.900}",
        "description": "base text on surface containers",
        "metadata": {
          "pair": "surface.card"
        }
      },
      "muted": {
        "value": "{colors.neutral.600}",
        "description": "muted text on surfaces",
        "metadata": {
          "pair": "surface.card"
        }
      },
      "subtle": {
        "value": "{colors.neutral.500}",
        "description": "subtle text on surfaces",
        "metadata": {
          "pair": "surface.card"
        }
      },
      "meta": {
        "value": "{colors.neutral.500}",
        "description": "meta text on surfaces",
        "metadata": {
          "pair": "surface.card"
        }
      },
      "brand": "{colors.brand.600}"
    },
    "onInverse": {
      "default": {
        "value": "{colors.neutral.50}",
        "description": "base text on surface.inverse, independent of page mode",
        "metadata": {
          "pair": "surface.inverse"
        }
      },
      "muted": {
        "value": "{colors.neutral.300}",
        "description": "muted text on surface.inverse",
        "metadata": {
          "pair": "surface.inverse"
        }
      }
    }
  },
  "layout": {
    "section": {
      "padding": {
        "sm": "1.5rem",
        "md": "2rem",
        "lg": "3rem",
        "xl": "4rem",
        "2xl": "5rem",
        "3xl": "6rem",
        "4xl": "8rem"
      },
      "gap": {
        "sm": "1rem",
        "md": "1.5rem",
        "lg": "2rem",
        "xl": "2.5rem",
        "2xl": "3rem",
        "3xl": "4rem",
        "4xl": "5rem"
      }
    },
    "stack": {
      "gap": {
        "sm": "0.5rem",
        "md": "1rem",
        "lg": "1.5rem",
        "xl": "2.5rem",
        "2xl": "3rem",
        "3xl": "4rem",
        "4xl": "5rem"
      }
    },
    "container": {
      "paddingInline": {
        "sm": "1rem",
        "md": "1.5rem",
        "lg": "2rem",
        "xl": "2.5rem",
        "2xl": "3rem",
        "3xl": "4rem",
        "4xl": "5rem"
      },
      "maxWidth": "72rem",
      "maxWidthProse": "65ch",
      "maxWidthWide": "80rem"
    },
    "hero": {
      "paddingTop": {
        "sm": "{layout.section.padding.2xl}",
        "md": "{layout.section.padding.3xl}",
        "lg": "{layout.section.padding.4xl}"
      },
      "paddingBottom": {
        "sm": "{layout.section.padding.xl}",
        "md": "{layout.section.padding.2xl}",
        "lg": "{layout.section.padding.3xl}"
      }
    },
    "sidebar": {
      "width": "16rem"
    },
    "responsive": {
      "lg": {
        "section": {
          "padding": {
            "xl": "6rem",
            "2xl": "8rem",
            "3xl": "10rem",
            "4xl": "12rem"
          },
          "gap": {
            "xl": "3rem",
            "2xl": "4rem",
            "3xl": "6rem",
            "4xl": "8rem"
          }
        },
        "stack": {
          "gap": {
            "xl": "3rem",
            "2xl": "4rem",
            "3xl": "6rem",
            "4xl": "8rem"
          }
        },
        "container": {
          "paddingInline": {
            "xl": "3rem",
            "2xl": "4rem",
            "3xl": "6rem",
            "4xl": "8rem"
          }
        }
      }
    }
  },
  "elevation": {
    "flat": {
      "shadow": "{shadows.none}",
      "surface": "{surface.page}",
      "zIndex": "{zIndex.base}"
    },
    "raised": {
      "shadow": "{shadows.md}",
      "surface": "{surface.card}",
      "zIndex": "{zIndex.base}"
    },
    "overlay": {
      "shadow": "{shadows.lg}",
      "surface": "{surface.card}",
      "zIndex": "{zIndex.dropdown}"
    },
    "modal": {
      "shadow": "{shadows.2xl}",
      "surface": "{surface.card}",
      "zIndex": "{zIndex.modal}"
    }
  }
}
